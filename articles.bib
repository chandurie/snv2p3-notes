@article{lim2025,
  title = {Quasi-Periodic Pulsations in Extreme-Ultraviolet Brightenings},
  author = {Lim, Daye and Doorsselaere, Tom Van and Berghmans, David and Hayes, Laura A. and Verbeeck, Cis and Narang, Nancy and Dominique, Marie and Inglis, Andrew R.},
  year = {2025},
